# Copy to .env and fill in one of the two paths. .env is gitignored.
# Ingest, retrieval and the tests need neither — only answer generation does.

# Default: bill answer generation to a Claude Pro/Max subscription.
#   claude setup-token     # prints a one-year OAuth token; it is not saved for you
answer_provider=claude_code
CLAUDE_CODE_OAUTHTOKEN=

# Alternative: pay per token through the Messages API.
# answer_provider=api
# ANTHROPIC_API_KEY=sk-ant-...
